{
  "name": "@gamex/specpack",
  "version": "0.0.0",
  "private": true,
  "description": "Renders and writes the Spec Pack into a target game repo.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@gamex/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@gamex/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p templates/tsconfig.json",
    "test": "vitest run --coverage",
    "gen:templates": "node scripts/embed-templates.mjs"
  },
  "dependencies": {
    "@gamex/engine": "workspace:*",
    "@gamex/model": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "yaml": "^2.9.1"
  }
}
