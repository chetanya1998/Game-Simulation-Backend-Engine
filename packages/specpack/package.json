{
  "name": "@gamex/specpack",
  "version": "0.0.0",
  "private": true,
  "description": "Renders and writes the Spec Pack into a target game repo.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@gamex/model": "workspace:*",
    "@gamex/engine": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
